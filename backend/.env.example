# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ML Models — absolute paths on your machine
NOSE_MODEL_PATH=/absolute/path/to/best.pt
EMBEDDER_MODEL_PATH=/absolute/path/to/dognose_megadescriptor_finetuned.pth

# Inference settings (calibrated — do not change without recalibrating)
MATCH_THRESHOLD=0.56
MATCH_MARGIN=0.08
USE_FINETUNED=true
ENABLE_CLAHE=false

# Rate limiting
IDENTIFY_RATE_LIMIT=10/minute

# File Uploads
MAX_FILE_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp
